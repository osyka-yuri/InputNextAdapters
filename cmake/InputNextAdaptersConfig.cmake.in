@PACKAGE_INIT@

if(@INPUTNEXTADAPTERS_PACKAGE_REQUIRES_CLANGCL_UBSAN_RUNTIME@)
    include("${CMAKE_CURRENT_LIST_DIR}/ClangClUbsan.cmake")
    inputnext_configure_clangcl_ubsan_runtime()
elseif(@INPUTNEXTADAPTERS_PACKAGE_REQUIRES_CLANGCL_ASAN_RUNTIME@)
    include("${CMAKE_CURRENT_LIST_DIR}/ClangClAsan.cmake")
    inputnext_configure_clangcl_asan_runtime()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/InputNextAdaptersTargets.cmake")
check_required_components(InputNextAdapters)
