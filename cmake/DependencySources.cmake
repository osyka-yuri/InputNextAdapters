include_guard(GLOBAL)

include("${CMAKE_CURRENT_LIST_DIR}/NativeDependencies.cmake")

set(INPUTNEXTADAPTERS_SOURCE_BUNDLE "" CACHE FILEPATH
    "Manifest in an outer-hash-verified InputNextAdapters source bundle")
option(INPUTNEXTADAPTERS_RELEASE_BUILD
    "Mark a fresh release-producing configure so dependency source overrides can be rejected"
    OFF)

function(_inputnext_json_quote output_variable value)
    string(REPLACE "\\" "\\\\" _escaped "${value}")
    string(REPLACE "\"" "\\\"" _escaped "${_escaped}")
    string(REPLACE "\n" "\\n" _escaped "${_escaped}")
    string(REPLACE "\r" "\\r" _escaped "${_escaped}")
    string(REPLACE "\t" "\\t" _escaped "${_escaped}")
    set(${output_variable} "\"${_escaped}\"" PARENT_SCOPE)
endfunction()

function(_inputnext_reject_release_source_overrides)
    if(NOT INPUTNEXTADAPTERS_RELEASE_BUILD)
        return()
    endif()

    if(INPUTNEXTADAPTERS_SOURCE_BUNDLE)
        message(FATAL_ERROR
            "Release-producing configures cannot consume INPUTNEXTADAPTERS_SOURCE_BUNDLE.")
    endif()

    get_cmake_property(_cache_variables CACHE_VARIABLES)
    get_directory_property(_directory_variables VARIABLES)
    list(APPEND _cache_variables ${_directory_variables})
    list(REMOVE_DUPLICATES _cache_variables)
    foreach(_variable IN LISTS _cache_variables)
        if(_variable MATCHES "^FETCHCONTENT_SOURCE_DIR_" AND DEFINED ${_variable})
            if(NOT "${${_variable}}" STREQUAL "")
                message(FATAL_ERROR
                    "Release-producing configures reject FetchContent source override ${_variable}.")
            endif()
        endif()
    endforeach()
endfunction()

function(_inputnext_source_bundle_collect_files root output_variable)
    set(_directories "${root}")
    set(_files)
    while(_directories)
        list(POP_FRONT _directories _directory)
        file(GLOB _entries LIST_DIRECTORIES TRUE "${_directory}/*" "${_directory}/.*")
        list(REMOVE_DUPLICATES _entries)
        foreach(_entry IN LISTS _entries)
            get_filename_component(_name "${_entry}" NAME)
            if(_name STREQUAL "." OR _name STREQUAL "..")
                continue()
            endif()
            if(_name STREQUAL ".git")
                message(FATAL_ERROR "Source bundles cannot contain Git metadata: '${_entry}'.")
            endif()
            if(IS_SYMLINK "${_entry}")
                message(FATAL_ERROR "Source bundles cannot contain links: '${_entry}'.")
            endif()
            if(IS_DIRECTORY "${_entry}")
                if(_name MATCHES "^([.]git|CMakeFiles|_deps|cmake-build-.*)$")
                    message(FATAL_ERROR
                        "Source bundles cannot contain build or Git metadata directories: '${_entry}'.")
                endif()
                list(APPEND _directories "${_entry}")
                continue()
            endif()
            if(NOT EXISTS "${_entry}")
                message(FATAL_ERROR "Source bundles contain an unsupported filesystem entry: '${_entry}'.")
            endif()
            if(_name MATCHES "^(CMakeCache[.]txt|cmake_install[.]cmake|build[.]ninja|compile_commands[.]json)$")
                message(FATAL_ERROR "Source bundles cannot contain generated build files: '${_entry}'.")
            endif()

            file(RELATIVE_PATH _relative "${root}" "${_entry}")
            string(REPLACE "\\" "/" _relative "${_relative}")
            if(_relative MATCHES "(^/|;|(^|/)[.][.](/|$)|(^|/)[.](/|$))")
                message(FATAL_ERROR "Source bundle file path is not normalized: '${_relative}'.")
            endif()
            string(REPLACE "/" ";" _components "${_relative}")
            set(_prefix_components)
            foreach(_component IN LISTS _components)
                list(APPEND _prefix_components "${_component}")
                string(JOIN "/" _prefix ${_prefix_components})
                string(TOLOWER "${_prefix}" _folded_prefix)
                list(FIND _folded_prefixes "${_folded_prefix}" _prefix_index)
                if(_prefix_index GREATER_EQUAL 0)
                    list(GET _original_prefixes ${_prefix_index} _original_prefix)
                    if(NOT _original_prefix STREQUAL _prefix)
                        message(FATAL_ERROR
                            "Source bundle contains case-colliding path components: '${_original_prefix}' and '${_prefix}'.")
                    endif()
                else()
                    list(APPEND _folded_prefixes "${_folded_prefix}")
                    list(APPEND _original_prefixes "${_prefix}")
                endif()
            endforeach()
            string(TOLOWER "${_relative}" _folded)
            if(_folded IN_LIST _folded_paths)
                message(FATAL_ERROR "Source bundle contains case-colliding file paths: '${_relative}'.")
            endif()
            list(APPEND _folded_paths "${_folded}")
            list(APPEND _files "${_relative}")
        endforeach()
    endwhile()
    list(SORT _files)
    set(${output_variable} "${_files}" PARENT_SCOPE)
endfunction()

function(_inputnext_source_bundle_validate_files json dependency_index source_root)
    string(JSON _files_json GET "${json}" dependencies ${dependency_index} files)
    string(JSON _files_type TYPE "${_files_json}")
    if(NOT _files_type STREQUAL "ARRAY")
        message(FATAL_ERROR "Every source bundle dependency must declare a files array.")
    endif()
    string(JSON _file_count LENGTH "${_files_json}")
    if(_file_count LESS 1)
        message(FATAL_ERROR "Source bundle dependency inventories cannot be empty.")
    endif()

    _inputnext_source_bundle_collect_files("${source_root}" _actual_files)
    list(LENGTH _actual_files _actual_file_count)
    if(NOT _file_count EQUAL _actual_file_count)
        message(FATAL_ERROR
            "Source bundle dependency inventory has ${_file_count} entries, but '${source_root}' has ${_actual_file_count} files.")
    endif()

    set(_manifest_files)
    set(_manifest_folded_paths)
    set(_manifest_sizes)
    set(_manifest_sha256s)
    foreach(_index RANGE 0 ${_file_count})
        if(_index GREATER_EQUAL _file_count)
            break()
        endif()
        string(JSON _file_json GET "${_files_json}" ${_index})
        string(JSON _path GET "${_file_json}" path)
        string(JSON _size GET "${_file_json}" size)
        string(JSON _sha256 GET "${_file_json}" sha256)
        string(JSON _path_type TYPE "${_file_json}" path)
        string(JSON _size_type TYPE "${_file_json}" size)
        string(JSON _sha256_type TYPE "${_file_json}" sha256)
        if(NOT _path_type STREQUAL "STRING" OR
           NOT _size_type STREQUAL "NUMBER" OR
           NOT _sha256_type STREQUAL "STRING")
            message(FATAL_ERROR "Source bundle inventory entries must have path, size, and sha256 fields.")
        endif()
        string(LENGTH "${_sha256}" _sha256_length)
        if(NOT _sha256_length EQUAL 64 OR NOT _sha256 MATCHES "^[0-9A-Fa-f]+$")
            message(FATAL_ERROR "Source bundle inventory contains an invalid SHA256 value.")
        endif()
        if(_path STREQUAL "" OR _path MATCHES "(^/|;|\\\\|(^|/)[.][.](/|$)|(^|/)[.](/|$))")
            message(FATAL_ERROR "Source bundle inventory path is not normalized: '${_path}'.")
        endif()
        string(TOLOWER "${_path}" _folded_path)
        if(_folded_path IN_LIST _manifest_folded_paths)
            message(FATAL_ERROR "Source bundle inventory contains case aliases: '${_path}'.")
        endif()
        list(APPEND _manifest_folded_paths "${_folded_path}")
        list(APPEND _manifest_files "${_path}")
        list(APPEND _manifest_sizes "${_size}")
        list(APPEND _manifest_sha256s "${_sha256}")
    endforeach()

    if(NOT _manifest_files STREQUAL _actual_files)
        message(FATAL_ERROR "Source bundle file inventory differs from '${source_root}'.")
    endif()

    foreach(_index RANGE 0 ${_file_count})
        if(_index GREATER_EQUAL _file_count)
            break()
        endif()
        list(GET _manifest_files ${_index} _path)
        list(GET _manifest_sizes ${_index} _declared_size)
        list(GET _manifest_sha256s ${_index} _declared_sha256)
        set(_file "${source_root}/${_path}")
        if(IS_SYMLINK "${_file}" OR IS_DIRECTORY "${_file}" OR NOT EXISTS "${_file}")
            message(FATAL_ERROR "Source bundle inventory entry is not a regular file: '${_path}'.")
        endif()
        file(SIZE "${_file}" _actual_size)
        file(SHA256 "${_file}" _actual_sha256)
        string(TOLOWER "${_declared_sha256}" _declared_sha256)
        if(NOT _declared_size MATCHES "^[0-9]+$" OR
           NOT _actual_size EQUAL _declared_size OR
           NOT _actual_sha256 STREQUAL _declared_sha256)
            message(FATAL_ERROR "Source bundle hash or size mismatch for '${_path}'.")
        endif()
    endforeach()
endfunction()

function(_inputnext_source_bundle_validate_patches json dependency_index dependency_name patch_specs source_root)
    string(JSON _patches_type TYPE "${json}" dependencies ${dependency_index} patches)
    if(NOT _patches_type STREQUAL "ARRAY")
        message(FATAL_ERROR "Every source bundle dependency must declare a patches array.")
    endif()
    string(JSON _patch_count LENGTH "${json}" dependencies ${dependency_index} patches)
    set(_expected_patches)
    foreach(_spec IN LISTS patch_specs)
        string(REPLACE "|" ";" _parts "${_spec}")
        list(LENGTH _parts _part_count)
        if(_part_count LESS 4)
            message(FATAL_ERROR "Invalid internal patch metadata '${_spec}'.")
        endif()
        list(GET _parts 0 _name)
        if(_name STREQUAL dependency_name)
            list(APPEND _expected_patches "${_spec}")
        endif()
    endforeach()
    list(LENGTH _expected_patches _expected_patch_count)
    if(NOT _patch_count EQUAL _expected_patch_count)
        message(FATAL_ERROR
            "Source bundle dependency '${dependency_name}' declares an unexpected amendment set.")
    endif()

    foreach(_index RANGE 0 ${_patch_count})
        if(_index GREATER_EQUAL _patch_count)
            break()
        endif()
        string(JSON _id GET "${json}" dependencies ${dependency_index} patches ${_index} id)
        string(JSON _path GET "${json}" dependencies ${dependency_index} patches ${_index} path)
        string(JSON _sha256 GET "${json}" dependencies ${dependency_index} patches ${_index} sha256)
        string(JSON _id_type TYPE "${json}" dependencies ${dependency_index} patches ${_index} id)
        string(JSON _path_type TYPE "${json}" dependencies ${dependency_index} patches ${_index} path)
        string(JSON _sha256_type TYPE "${json}" dependencies ${dependency_index} patches ${_index} sha256)
        if(NOT _id_type STREQUAL "STRING" OR
           NOT _path_type STREQUAL "STRING" OR
           NOT _sha256_type STREQUAL "STRING")
            message(FATAL_ERROR "Source bundle amendment entries must have string id, path, and sha256 fields.")
        endif()
        set(_found FALSE)
        foreach(_spec IN LISTS _expected_patches)
            string(REPLACE "|" ";" _parts "${_spec}")
            list(GET _parts 1 _expected_id)
            list(GET _parts 2 _expected_path)
            list(GET _parts 3 _allowed_hashes)
            if(_id STREQUAL _expected_id AND _path STREQUAL _expected_path)
                string(TOLOWER "${_sha256}" _sha256)
                string(TOLOWER "${_allowed_hashes}" _allowed_hashes)
                string(REPLACE "," ";" _allowed_hashes "${_allowed_hashes}")
                if(NOT _sha256 IN_LIST _allowed_hashes)
                    message(FATAL_ERROR
                        "Source bundle amendment '${_id}' has an unapproved output hash.")
                endif()
                set(_patch_file "${source_root}/${_path}")
                if(IS_SYMLINK "${_patch_file}" OR IS_DIRECTORY "${_patch_file}" OR
                   NOT EXISTS "${_patch_file}")
                    message(FATAL_ERROR "Source bundle amendment file is missing or not regular: '${_path}'.")
                endif()
                file(SHA256 "${_patch_file}" _actual_patch_sha256)
                if(NOT _actual_patch_sha256 STREQUAL _sha256)
                    message(FATAL_ERROR "Source bundle amendment hash does not match '${_path}'.")
                endif()
                set(_found TRUE)
                break()
            endif()
        endforeach()
        if(NOT _found)
            message(FATAL_ERROR "Source bundle contains an undeclared amendment '${_id}'.")
        endif()
    endforeach()
endfunction()

function(_inputnext_source_bundle_validate_submodules json dependency_index dependency_name submodule_specs source_root)
    string(JSON _submodules_type TYPE "${json}" dependencies ${dependency_index} submodules)
    if(NOT _submodules_type STREQUAL "ARRAY")
        message(FATAL_ERROR "Every source bundle dependency must declare a submodules array.")
    endif()
    string(JSON _submodule_count LENGTH "${json}" dependencies ${dependency_index} submodules)
    set(_expected_submodules)
    foreach(_spec IN LISTS submodule_specs)
        string(REPLACE "|" ";" _parts "${_spec}")
        list(GET _parts 0 _parent_name)
        if(_parent_name STREQUAL dependency_name)
            list(APPEND _expected_submodules "${_spec}")
        endif()
    endforeach()
    list(LENGTH _expected_submodules _expected_count)
    if(NOT _submodule_count EQUAL _expected_count)
        message(FATAL_ERROR
            "Source bundle dependency '${dependency_name}' declares an unexpected submodule set.")
    endif()

    foreach(_index RANGE 0 ${_submodule_count})
        if(_index GREATER_EQUAL _submodule_count)
            break()
        endif()
        string(JSON _name GET "${json}" dependencies ${dependency_index} submodules ${_index} name)
        string(JSON _path GET "${json}" dependencies ${dependency_index} submodules ${_index} path)
        string(JSON _repository GET "${json}" dependencies ${dependency_index} submodules ${_index} repository)
        string(JSON _revision GET "${json}" dependencies ${dependency_index} submodules ${_index} revision)
        string(JSON _name_type TYPE "${json}" dependencies ${dependency_index} submodules ${_index} name)
        string(JSON _path_type TYPE "${json}" dependencies ${dependency_index} submodules ${_index} path)
        string(JSON _repository_type TYPE "${json}" dependencies ${dependency_index} submodules ${_index} repository)
        string(JSON _revision_type TYPE "${json}" dependencies ${dependency_index} submodules ${_index} revision)
        if(NOT _name_type STREQUAL "STRING" OR NOT _path_type STREQUAL "STRING" OR
           NOT _repository_type STREQUAL "STRING" OR NOT _revision_type STREQUAL "STRING")
            message(FATAL_ERROR "Source bundle submodule identity fields must be strings.")
        endif()
        set(_found FALSE)
        foreach(_spec IN LISTS _expected_submodules)
            string(REPLACE "|" ";" _parts "${_spec}")
            list(GET _parts 1 _expected_name)
            list(GET _parts 2 _expected_path)
            list(GET _parts 3 _expected_repository)
            list(GET _parts 4 _expected_revision)
            if(_name STREQUAL _expected_name AND _path STREQUAL _expected_path AND
               _repository STREQUAL _expected_repository AND _revision STREQUAL _expected_revision)
                set(_found TRUE)
                break()
            endif()
        endforeach()
        if(NOT _found)
            message(FATAL_ERROR "Source bundle contains an unexpected submodule identity in '${dependency_name}'.")
        endif()
        if(_path MATCHES "(^/|\\\\|(^|/)[.][.](/|$)|(^|/)[.](/|$))")
            message(FATAL_ERROR "Source bundle submodule path is not normalized: '${_path}'.")
        endif()
        set(_submodule_root "${source_root}/${_path}")
        file(REAL_PATH "${_submodule_root}" _submodule_real)
        cmake_path(IS_PREFIX source_root "${_submodule_real}" NORMALIZE _inside_dependency)
        if(NOT _inside_dependency OR NOT IS_DIRECTORY "${_submodule_real}")
            message(FATAL_ERROR "Source bundle submodule path escapes or is missing: '${_path}'.")
        endif()
    endforeach()
endfunction()

function(inputnext_require_source_git_revision source_directory expected_revision label)
    if(NOT EXISTS "${source_directory}" OR NOT IS_DIRECTORY "${source_directory}")
        message(FATAL_ERROR "${label} source directory is missing: '${source_directory}'.")
    endif()
    find_package(Git REQUIRED)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${source_directory}" rev-parse HEAD
        RESULT_VARIABLE _git_result
        OUTPUT_VARIABLE _actual_revision
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    if(NOT _git_result EQUAL 0 OR NOT _actual_revision STREQUAL expected_revision)
        message(FATAL_ERROR
            "${label} must resolve to ${expected_revision}; got '${_actual_revision}'.")
    endif()
endfunction()

function(inputnext_prepare_dependency_sources product)
    set(_options)
    set(_one_value_args)
    set(_multi_value_args DEPENDENCIES PATCHES SUBMODULES)
    cmake_parse_arguments(PARSE_ARGV 1 _bundle "${_options}" "${_one_value_args}" "${_multi_value_args}")
    if(_bundle_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "inputnext_prepare_dependency_sources received unsupported arguments.")
    endif()
    if(NOT _bundle_DEPENDENCIES AND NOT _bundle_PATCHES AND NOT _bundle_SUBMODULES)
        inputnext_native_dependency_specs("${product}" _bundle_DEPENDENCIES _bundle_PATCHES _bundle_SUBMODULES)
    elseif(NOT _bundle_DEPENDENCIES)
        message(FATAL_ERROR "inputnext_prepare_dependency_sources requires dependency metadata.")
    endif()
    _inputnext_reject_release_source_overrides()
    set(INPUTNEXTADAPTERS_SOURCE_BUNDLE_VALIDATED OFF PARENT_SCOPE)

    if(NOT INPUTNEXTADAPTERS_SOURCE_BUNDLE)
        return()
    endif()

    if(NOT IS_ABSOLUTE "${INPUTNEXTADAPTERS_SOURCE_BUNDLE}")
        get_filename_component(_manifest_candidate "${INPUTNEXTADAPTERS_SOURCE_BUNDLE}"
            ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    else()
        set(_manifest_candidate "${INPUTNEXTADAPTERS_SOURCE_BUNDLE}")
    endif()
    file(REAL_PATH "${_manifest_candidate}" _manifest)
    if(IS_SYMLINK "${_manifest_candidate}" OR
       NOT EXISTS "${_manifest}" OR IS_DIRECTORY "${_manifest}")
        message(FATAL_ERROR "INPUTNEXTADAPTERS_SOURCE_BUNDLE must identify an existing manifest file.")
    endif()
    get_filename_component(_manifest_name "${_manifest}" NAME)
    if(NOT _manifest_name STREQUAL "inputnext-adapters-source.json")
        message(FATAL_ERROR
            "The source bundle manifest must be named inputnext-adapters-source.json.")
    endif()
    get_filename_component(_bundle_root "${_manifest}" DIRECTORY)
    file(REAL_PATH "${_bundle_root}" _bundle_root)
    file(READ "${_manifest}" _json)
    string(JSON _schema_version GET "${_json}" schemaVersion)
    string(JSON _kind GET "${_json}" kind)
    string(JSON _manifest_product GET "${_json}" product)
    string(JSON _schema_version_type TYPE "${_json}" schemaVersion)
    string(JSON _kind_type TYPE "${_json}" kind)
    string(JSON _product_type TYPE "${_json}" product)
    if(NOT _schema_version_type STREQUAL "NUMBER" OR
       NOT _kind_type STREQUAL "STRING" OR NOT _product_type STREQUAL "STRING")
        message(FATAL_ERROR "The source bundle manifest identity fields have invalid types.")
    endif()
    if(NOT _schema_version EQUAL 1 OR
       NOT _kind STREQUAL "inputnext-adapters-source-bundle" OR
       NOT _manifest_product STREQUAL product)
        message(FATAL_ERROR "The source bundle manifest has an unsupported schema or product identity.")
    endif()

    string(JSON _dependency_count LENGTH "${_json}" dependencies)
    list(LENGTH _bundle_DEPENDENCIES _expected_dependency_count)
    if(NOT _dependency_count EQUAL _expected_dependency_count)
        message(FATAL_ERROR "The source bundle dependency inventory is incomplete or contains extras.")
    endif()

    set(_overrides)
    set(_folded_names)
    set(_dependency_index 0)
    foreach(_spec IN LISTS _bundle_DEPENDENCIES)
        string(REPLACE "|" ";" _parts "${_spec}")
        list(LENGTH _parts _part_count)
        if(NOT _part_count EQUAL 5)
            message(FATAL_ERROR "Invalid internal dependency metadata '${_spec}'.")
        endif()
        list(GET _parts 0 _name)
        list(GET _parts 1 _repository)
        list(GET _parts 2 _revision)
        list(GET _parts 3 _relative_path)
        list(GET _parts 4 _fetch_content_name)
        string(TOLOWER "${_name}" _folded_name)
        if(_folded_name IN_LIST _folded_names)
            message(FATAL_ERROR "Duplicate internal dependency name '${_name}'.")
        endif()
        list(APPEND _folded_names "${_folded_name}")

        string(JSON _entry_name GET "${_json}" dependencies ${_dependency_index} name)
        string(JSON _entry_repository GET "${_json}" dependencies ${_dependency_index} repository)
        string(JSON _entry_revision GET "${_json}" dependencies ${_dependency_index} revision)
        string(JSON _entry_path GET "${_json}" dependencies ${_dependency_index} path)
        string(JSON _entry_fetch_content_name GET "${_json}" dependencies ${_dependency_index} fetchContent)
        string(JSON _entry_name_type TYPE "${_json}" dependencies ${_dependency_index} name)
        string(JSON _entry_repository_type TYPE "${_json}" dependencies ${_dependency_index} repository)
        string(JSON _entry_revision_type TYPE "${_json}" dependencies ${_dependency_index} revision)
        string(JSON _entry_path_type TYPE "${_json}" dependencies ${_dependency_index} path)
        string(JSON _entry_fetch_content_type TYPE "${_json}" dependencies ${_dependency_index} fetchContent)
        if(NOT _entry_name_type STREQUAL "STRING" OR
           NOT _entry_repository_type STREQUAL "STRING" OR
           NOT _entry_revision_type STREQUAL "STRING" OR
           NOT _entry_path_type STREQUAL "STRING" OR
           NOT _entry_fetch_content_type STREQUAL "STRING")
            message(FATAL_ERROR "Source bundle dependency identity fields must be strings.")
        endif()
        if(NOT _entry_name STREQUAL _name OR
           NOT _entry_repository STREQUAL _repository OR
           NOT _entry_revision STREQUAL _revision OR
           NOT _entry_path STREQUAL _relative_path OR
           NOT _entry_fetch_content_name STREQUAL _fetch_content_name)
            message(FATAL_ERROR "Source bundle dependency identity mismatch for '${_name}'.")
        endif()
        if(_relative_path MATCHES "(^/|\\\\|(^|/)[.][.](/|$)|(^|/)[.](/|$))")
            message(FATAL_ERROR "Source bundle dependency path is not normalized: '${_relative_path}'.")
        endif()
        set(_source_candidate "${_bundle_root}/${_relative_path}")
        file(REAL_PATH "${_source_candidate}" _source_root)
        cmake_path(IS_PREFIX _bundle_root "${_source_root}" NORMALIZE _inside_bundle)
        if(NOT _inside_bundle OR NOT IS_DIRECTORY "${_source_root}")
            message(FATAL_ERROR "Source bundle dependency path escapes or is missing: '${_relative_path}'.")
        endif()

        _inputnext_source_bundle_validate_files("${_json}" "${_dependency_index}" "${_source_root}")
        _inputnext_source_bundle_validate_patches(
            "${_json}" "${_dependency_index}" "${_name}" "${_bundle_PATCHES}" "${_source_root}")
        _inputnext_source_bundle_validate_submodules("${_json}" "${_dependency_index}" "${_name}" "${_bundle_SUBMODULES}" "${_source_root}")
        string(TOUPPER "${_fetch_content_name}" _fetch_content_key)
        list(APPEND _overrides "${_fetch_content_key}|${_source_root}")
        math(EXPR _dependency_index "${_dependency_index} + 1")
    endforeach()

    foreach(_override IN LISTS _overrides)
        string(REPLACE "|" ";" _parts "${_override}")
        list(GET _parts 0 _fetch_content_key)
        list(GET _parts 1 _source_root)
        set(FETCHCONTENT_SOURCE_DIR_${_fetch_content_key} "${_source_root}" PARENT_SCOPE)
    endforeach()
    set(INPUTNEXTADAPTERS_SOURCE_BUNDLE_VALIDATED ON PARENT_SCOPE)
endfunction()

function(inputnext_write_dependency_source_receipt product)
    set(_multi_value_args DEPENDENCIES PATCHES)
    cmake_parse_arguments(PARSE_ARGV 1 _receipt "" "" "${_multi_value_args}")
    if(_receipt_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "inputnext_write_dependency_source_receipt received unsupported arguments.")
    endif()
    if(NOT _receipt_DEPENDENCIES AND NOT _receipt_PATCHES)
        inputnext_native_dependency_names("${product}" _dependency_names)
        set(_dependencies)
        set(_patches)
        foreach(_dependency IN LISTS _dependency_names)
            inputnext_native_dependency_metadata("${product}" "${_dependency}" _metadata)
            set(_source_variable "${_metadata_FETCHCONTENT}_SOURCE_DIR")
            if(NOT DEFINED ${_source_variable})
                message(FATAL_ERROR "FetchContent did not provide the declared source directory for '${_dependency}'.")
            endif()
            list(APPEND _dependencies
                "${_dependency}|${_metadata_REPOSITORY}|${_metadata_REVISION}|${${_source_variable}}")
            list(APPEND _patches ${_metadata_PATCH_SPECS})
            foreach(_submodule_spec IN LISTS _metadata_SUBMODULE_SPECS)
                string(REPLACE "|" ";" _submodule_parts "${_submodule_spec}")
                list(GET _submodule_parts 1 _submodule_name)
                list(GET _submodule_parts 2 _submodule_path)
                list(GET _submodule_parts 3 _submodule_repository)
                list(GET _submodule_parts 4 _submodule_revision)
                list(APPEND _dependencies
                    "${_submodule_name}|${_submodule_repository}|${_submodule_revision}|${${_source_variable}}/${_submodule_path}")
            endforeach()
        endforeach()
        set(_receipt_DEPENDENCIES "${_dependencies}")
        set(_receipt_PATCHES "${_patches}")
    elseif(NOT _receipt_DEPENDENCIES)
        message(FATAL_ERROR "inputnext_write_dependency_source_receipt requires dependency metadata.")
    endif()

    set(_json "{\n  \"schemaVersion\": 1,\n  \"product\": \"${product}\",\n  \"dependencies\": [")
    set(_first_dependency TRUE)
    foreach(_spec IN LISTS _receipt_DEPENDENCIES)
        string(REPLACE "|" ";" _parts "${_spec}")
        list(LENGTH _parts _part_count)
        if(NOT _part_count EQUAL 4)
            message(FATAL_ERROR "Invalid internal dependency receipt metadata '${_spec}'.")
        endif()
        list(GET _parts 0 _name)
        list(GET _parts 1 _repository)
        list(GET _parts 2 _revision)
        list(GET _parts 3 _source_directory)
        if(NOT EXISTS "${_source_directory}" OR NOT IS_DIRECTORY "${_source_directory}")
            message(FATAL_ERROR "Used dependency source directory is missing: '${_source_directory}'.")
        endif()
        file(REAL_PATH "${_source_directory}" _canonical_source)
        file(TO_CMAKE_PATH "${_canonical_source}" _canonical_source)
        _inputnext_json_quote(_name_json "${_name}")
        _inputnext_json_quote(_repository_json "${_repository}")
        _inputnext_json_quote(_revision_json "${_revision}")
        _inputnext_json_quote(_source_json "${_canonical_source}")
        if(_first_dependency)
            set(_first_dependency FALSE)
        else()
            string(APPEND _json ",")
        endif()
        string(APPEND _json "\n    {\"name\": ${_name_json}, \"sourceDirectory\": ${_source_json}, \"repository\": ${_repository_json}, \"revision\": ${_revision_json}, \"patches\": [")
        set(_first_patch TRUE)
        foreach(_patch_spec IN LISTS _receipt_PATCHES)
            string(REPLACE "|" ";" _patch_parts "${_patch_spec}")
            list(GET _patch_parts 0 _patch_dependency)
            if(NOT _patch_dependency STREQUAL _name)
                continue()
            endif()
            list(GET _patch_parts 1 _patch_id)
            list(GET _patch_parts 2 _patch_path)
            file(SHA256 "${_canonical_source}/${_patch_path}" _patch_sha256)
            _inputnext_json_quote(_patch_id_json "${_patch_id}")
            _inputnext_json_quote(_patch_path_json "${_patch_path}")
            _inputnext_json_quote(_patch_sha256_json "${_patch_sha256}")
            if(_first_patch)
                set(_first_patch FALSE)
            else()
                string(APPEND _json ",")
            endif()
            string(APPEND _json "{\"id\": ${_patch_id_json}, \"path\": ${_patch_path_json}, \"sha256\": ${_patch_sha256_json}}")
        endforeach()
        string(APPEND _json "]}")
    endforeach()
    string(APPEND _json "\n  ]\n}\n")
    file(WRITE "${CMAKE_BINARY_DIR}/inputnext-adapters-dependency-sources.json" "${_json}")
endfunction()
