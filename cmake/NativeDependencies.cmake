include_guard(GLOBAL)

function(_inputnext_native_catalog_read output_json)
    set(_catalog_path "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/NativeDependencies.json")
    if(NOT EXISTS "${_catalog_path}" OR IS_DIRECTORY "${_catalog_path}")
        message(FATAL_ERROR "The repository-owned native dependency catalog is missing: '${_catalog_path}'.")
    endif()
    file(READ "${_catalog_path}" _json)
    string(JSON _schema_version ERROR_VARIABLE _schema_error GET "${_json}" schemaVersion)
    string(JSON _schema_type ERROR_VARIABLE _type_error TYPE "${_json}" schemaVersion)
    string(JSON _products_type ERROR_VARIABLE _products_error TYPE "${_json}" products)
    if(NOT _schema_error STREQUAL "NOTFOUND" OR
       NOT _type_error STREQUAL "NOTFOUND" OR
       NOT _products_error STREQUAL "NOTFOUND" OR
       NOT _schema_type STREQUAL "NUMBER" OR
       NOT _schema_version EQUAL 1 OR
       NOT _products_type STREQUAL "ARRAY")
        message(FATAL_ERROR "The repository-owned native dependency catalog is malformed or unsupported.")
    endif()
    set(${output_json} "${_json}" PARENT_SCOPE)
endfunction()

function(_inputnext_native_product_index json product output_index output_dependency_count)
    string(JSON _product_count LENGTH "${json}" products)
    set(_found_index "")
    foreach(_index RANGE 0 ${_product_count})
        if(_index GREATER_EQUAL _product_count)
            break()
        endif()
        string(JSON _name_type ERROR_VARIABLE _name_type_error TYPE "${json}" products ${_index} name)
        string(JSON _name ERROR_VARIABLE _name_error GET "${json}" products ${_index} name)
        string(JSON _dependencies_type ERROR_VARIABLE _dependencies_error TYPE "${json}" products ${_index} dependencies)
        if(NOT _name_type_error STREQUAL "NOTFOUND" OR
           NOT _name_error STREQUAL "NOTFOUND" OR
           NOT _dependencies_error STREQUAL "NOTFOUND" OR
           NOT _name_type STREQUAL "STRING" OR
           NOT _dependencies_type STREQUAL "ARRAY")
            message(FATAL_ERROR "The native dependency catalog has a malformed product entry.")
        endif()
        if(_name STREQUAL product)
            if(NOT _found_index STREQUAL "")
                message(FATAL_ERROR "The native dependency catalog repeats product '${product}'.")
            endif()
            set(_found_index "${_index}")
        endif()
    endforeach()
    if(_found_index STREQUAL "")
        message(FATAL_ERROR "The native dependency catalog has no '${product}' product.")
    endif()
    string(JSON _dependency_count LENGTH "${json}" products ${_found_index} dependencies)
    set(${output_index} "${_found_index}" PARENT_SCOPE)
    set(${output_dependency_count} "${_dependency_count}" PARENT_SCOPE)
endfunction()

function(_inputnext_native_dependency_index json product_index dependency output_index)
    string(JSON _dependency_count LENGTH "${json}" products ${product_index} dependencies)
    set(_found_index "")
    foreach(_index RANGE 0 ${_dependency_count})
        if(_index GREATER_EQUAL _dependency_count)
            break()
        endif()
        string(JSON _name_type ERROR_VARIABLE _name_type_error TYPE "${json}" products ${product_index} dependencies ${_index} name)
        string(JSON _name ERROR_VARIABLE _name_error GET "${json}" products ${product_index} dependencies ${_index} name)
        if(NOT _name_type_error STREQUAL "NOTFOUND" OR
           NOT _name_error STREQUAL "NOTFOUND" OR
           NOT _name_type STREQUAL "STRING")
            message(FATAL_ERROR "The native dependency catalog has a malformed dependency entry.")
        endif()
        if(_name STREQUAL dependency)
            if(NOT _found_index STREQUAL "")
                message(FATAL_ERROR "The native dependency catalog repeats '${dependency}' for one product.")
            endif()
            set(_found_index "${_index}")
        endif()
    endforeach()
    if(_found_index STREQUAL "")
        message(FATAL_ERROR "The native dependency catalog has no '${dependency}' dependency.")
    endif()
    set(${output_index} "${_found_index}" PARENT_SCOPE)
endfunction()

function(inputnext_native_dependency_names product output_names)
    _inputnext_native_catalog_read(_json)
    _inputnext_native_product_index("${_json}" "${product}" _product_index _dependency_count)
    set(_names)
    set(_folded_names)
    foreach(_index RANGE 0 ${_dependency_count})
        if(_index GREATER_EQUAL _dependency_count)
            break()
        endif()
        string(JSON _name GET "${_json}" products ${_product_index} dependencies ${_index} name)
        string(TOLOWER "${_name}" _folded_name)
        if(_folded_name IN_LIST _folded_names)
            message(FATAL_ERROR "The native dependency catalog repeats dependency '${_name}'.")
        endif()
        list(APPEND _folded_names "${_folded_name}")
        list(APPEND _names "${_name}")
    endforeach()
    set(${output_names} "${_names}" PARENT_SCOPE)
endfunction()

function(inputnext_native_dependency_patch_metadata product dependency patch_id output_prefix)
    _inputnext_native_catalog_read(_json)
    _inputnext_native_product_index("${_json}" "${product}" _product_index _dependency_count)
    _inputnext_native_dependency_index("${_json}" "${_product_index}" "${dependency}" _dependency_index)
    string(JSON _patch_count LENGTH "${_json}" products ${_product_index} dependencies ${_dependency_index} patches)
    set(_found_index "")
    foreach(_index RANGE 0 ${_patch_count})
        if(_index GREATER_EQUAL _patch_count)
            break()
        endif()
        string(JSON _id_type ERROR_VARIABLE _id_type_error TYPE "${_json}" products ${_product_index} dependencies ${_dependency_index} patches ${_index} id)
        string(JSON _id ERROR_VARIABLE _id_error GET "${_json}" products ${_product_index} dependencies ${_dependency_index} patches ${_index} id)
        if(NOT _id_type_error STREQUAL "NOTFOUND" OR NOT _id_error STREQUAL "NOTFOUND" OR NOT _id_type STREQUAL "STRING")
            message(FATAL_ERROR "The native dependency catalog has a malformed amendment entry.")
        endif()
        if(_id STREQUAL patch_id)
            if(NOT _found_index STREQUAL "")
                message(FATAL_ERROR "The native dependency catalog repeats amendment '${patch_id}'.")
            endif()
            set(_found_index "${_index}")
        endif()
    endforeach()
    if(_found_index STREQUAL "")
        message(FATAL_ERROR "The native dependency catalog has no '${patch_id}' amendment for '${dependency}'.")
    endif()

    string(JSON _path GET "${_json}" products ${_product_index} dependencies ${_dependency_index} patches ${_found_index} path)
    foreach(_newline IN ITEMS lf crlf)
        foreach(_direction IN ITEMS inputSha256 outputSha256)
            string(JSON _hash GET "${_json}" products ${_product_index} dependencies ${_dependency_index} patches ${_found_index} ${_direction} ${_newline})
            string(LENGTH "${_hash}" _hash_length)
            if(NOT _hash_length EQUAL 64 OR NOT _hash MATCHES "^[0-9a-fA-F]+$")
                message(FATAL_ERROR "The native dependency catalog has an invalid amendment SHA256.")
            endif()
            if(_direction STREQUAL "inputSha256")
                set(${output_prefix}_INPUT_${_newline} "${_hash}" PARENT_SCOPE)
            else()
                set(${output_prefix}_OUTPUT_${_newline} "${_hash}" PARENT_SCOPE)
            endif()
        endforeach()
    endforeach()
    set(${output_prefix}_ID "${patch_id}" PARENT_SCOPE)
    set(${output_prefix}_PATH "${_path}" PARENT_SCOPE)
endfunction()

function(inputnext_native_dependency_patch_ids product dependency output_ids)
    _inputnext_native_catalog_read(_json)
    _inputnext_native_product_index("${_json}" "${product}" _product_index _dependency_count)
    _inputnext_native_dependency_index("${_json}" "${_product_index}" "${dependency}" _dependency_index)
    string(JSON _patch_count LENGTH "${_json}" products ${_product_index} dependencies ${_dependency_index} patches)
    set(_ids)
    set(_folded_ids)
    foreach(_index RANGE 0 ${_patch_count})
        if(_index GREATER_EQUAL _patch_count)
            break()
        endif()
        string(JSON _id GET "${_json}" products ${_product_index} dependencies ${_dependency_index} patches ${_index} id)
        string(TOLOWER "${_id}" _folded_id)
        if(_id STREQUAL "" OR _folded_id IN_LIST _folded_ids)
            message(FATAL_ERROR "The native dependency catalog has an empty or duplicate amendment ID.")
        endif()
        list(APPEND _folded_ids "${_folded_id}")
        list(APPEND _ids "${_id}")
    endforeach()
    set(${output_ids} "${_ids}" PARENT_SCOPE)
endfunction()

function(inputnext_native_dependency_metadata product dependency output_prefix)
    _inputnext_native_catalog_read(_json)
    _inputnext_native_product_index("${_json}" "${product}" _product_index _dependency_count)
    _inputnext_native_dependency_index("${_json}" "${_product_index}" "${dependency}" _dependency_index)
    foreach(_field IN ITEMS repository revision path fetchContent)
        string(JSON _field_type ERROR_VARIABLE _field_type_error TYPE "${_json}" products ${_product_index} dependencies ${_dependency_index} ${_field})
        string(JSON _value ERROR_VARIABLE _field_error GET "${_json}" products ${_product_index} dependencies ${_dependency_index} ${_field})
        if(NOT _field_type_error STREQUAL "NOTFOUND" OR
           NOT _field_error STREQUAL "NOTFOUND" OR
           NOT _field_type STREQUAL "STRING" OR
           _value STREQUAL "" OR
           _value MATCHES "[;|\r\n]")
            message(FATAL_ERROR "The native dependency catalog has an invalid '${_field}' for '${dependency}'.")
        endif()
        string(TOUPPER "${_field}" _field_upper)
        set(_${_field_upper} "${_value}")
        set(${output_prefix}_${_field_upper} "${_value}" PARENT_SCOPE)
    endforeach()
    set(_revision "${_REVISION}")
    string(LENGTH "${_revision}" _revision_length)
    if(NOT _revision_length EQUAL 40 OR NOT _revision MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "The native dependency catalog has an invalid Git revision for '${dependency}'.")
    endif()
    set(_submodule_count 0)
    string(JSON _submodule_count LENGTH "${_json}" products ${_product_index} dependencies ${_dependency_index} submodules)
    set(_submodule_specs)
    set(_submodule_paths)
    foreach(_index RANGE 0 ${_submodule_count})
        if(_index GREATER_EQUAL _submodule_count)
            break()
        endif()
        foreach(_field IN ITEMS name path repository revision)
            string(JSON _field_type TYPE "${_json}" products ${_product_index} dependencies ${_dependency_index} submodules ${_index} ${_field})
            string(JSON _value GET "${_json}" products ${_product_index} dependencies ${_dependency_index} submodules ${_index} ${_field})
            if(NOT _field_type STREQUAL "STRING" OR _value STREQUAL "" OR _value MATCHES "[;|\r\n]")
                message(FATAL_ERROR "The native dependency catalog has invalid submodule metadata for '${dependency}'.")
            endif()
            string(TOUPPER "${_field}" _field_upper)
            set(_submodule_${_index}_${_field_upper} "${_value}")
        endforeach()
        string(LENGTH "${_submodule_${_index}_REVISION}" _submodule_revision_length)
        if(NOT _submodule_revision_length EQUAL 40 OR NOT _submodule_${_index}_REVISION MATCHES "^[0-9a-fA-F]+$")
            message(FATAL_ERROR "The native dependency catalog has an invalid submodule revision.")
        endif()
        list(APPEND _submodule_paths "${_submodule_${_index}_PATH}")
        list(APPEND _submodule_specs
            "${dependency}|${_submodule_${_index}_NAME}|${_submodule_${_index}_PATH}|${_submodule_${_index}_REPOSITORY}|${_submodule_${_index}_REVISION}")
    endforeach()
    set(${output_prefix}_SUBMODULE_SPECS "${_submodule_specs}" PARENT_SCOPE)
    set(${output_prefix}_SUBMODULE_PATHS "${_submodule_paths}" PARENT_SCOPE)

    string(JSON _patch_count LENGTH "${_json}" products ${_product_index} dependencies ${_dependency_index} patches)
    set(_patch_specs)
    foreach(_index RANGE 0 ${_patch_count})
        if(_index GREATER_EQUAL _patch_count)
            break()
        endif()
        string(JSON _patch_id GET "${_json}" products ${_product_index} dependencies ${_dependency_index} patches ${_index} id)
        inputnext_native_dependency_patch_metadata("${product}" "${dependency}" "${_patch_id}" _patch)
        list(APPEND _patch_specs "${dependency}|${_patch_ID}|${_patch_PATH}|${_patch_OUTPUT_lf},${_patch_OUTPUT_crlf}")
    endforeach()
    set(${output_prefix}_PATCH_SPECS "${_patch_specs}" PARENT_SCOPE)
endfunction()

function(inputnext_native_dependency_specs product output_dependencies output_patches output_submodules)
    inputnext_native_dependency_names("${product}" _names)
    set(_dependencies)
    set(_patches)
    set(_submodules)
    foreach(_name IN LISTS _names)
        inputnext_native_dependency_metadata("${product}" "${_name}" _metadata)
        list(APPEND _dependencies
            "${_name}|${_metadata_REPOSITORY}|${_metadata_REVISION}|${_metadata_PATH}|${_metadata_FETCHCONTENT}")
        list(APPEND _patches ${_metadata_PATCH_SPECS})
        list(APPEND _submodules ${_metadata_SUBMODULE_SPECS})
    endforeach()
    set(${output_dependencies} "${_dependencies}" PARENT_SCOPE)
    set(${output_patches} "${_patches}" PARENT_SCOPE)
    set(${output_submodules} "${_submodules}" PARENT_SCOPE)
endfunction()

function(inputnext_declare_native_dependency product dependency)
    set(_options OVERRIDE_FIND_PACKAGE RECURSE_SUBMODULES)
    set(_one_value_args SOURCE_SUBDIR)
    cmake_parse_arguments(PARSE_ARGV 2 _declare "${_options}" "${_one_value_args}" "")
    if(_declare_UNPARSED_ARGUMENTS OR _declare_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "inputnext_declare_native_dependency received unsupported arguments.")
    endif()
    inputnext_native_dependency_metadata("${product}" "${dependency}" _metadata)
    include(FetchContent)
    set(_arguments
        GIT_REPOSITORY "${_metadata_REPOSITORY}"
        GIT_TAG "${_metadata_REVISION}"
        GIT_SHALLOW FALSE
    )
    if(_declare_RECURSE_SUBMODULES)
        if(NOT _metadata_SUBMODULE_PATHS)
            message(FATAL_ERROR "Recursive submodule fetching requires cataloged submodules.")
        endif()
        list(APPEND _arguments GIT_SUBMODULES ${_metadata_SUBMODULE_PATHS} GIT_SUBMODULES_RECURSE ON)
    endif()
    if(_declare_OVERRIDE_FIND_PACKAGE)
        list(APPEND _arguments OVERRIDE_FIND_PACKAGE)
    endif()
    if(DEFINED _declare_SOURCE_SUBDIR)
        list(APPEND _arguments SOURCE_SUBDIR "${_declare_SOURCE_SUBDIR}")
    endif()
    FetchContent_Declare("${_metadata_FETCHCONTENT}" ${_arguments})
endfunction()
