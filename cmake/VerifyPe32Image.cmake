if(NOT DEFINED product_name OR product_name STREQUAL "")
    set(product_name "Windows plugin")
endif()
if(NOT DEFINED image OR NOT EXISTS "${image}")
    message(FATAL_ERROR "The ${product_name} image does not exist.")
endif()

file(SIZE "${image}" image_size)
if(image_size LESS 64)
    message(FATAL_ERROR "The ${product_name} image is too small to contain a DOS header.")
endif()

file(READ "${image}" dos_magic LIMIT 2 HEX)
file(READ "${image}" pe_offset_bytes OFFSET 60 LIMIT 4 HEX)
if(NOT dos_magic STREQUAL "4d5a" OR NOT pe_offset_bytes MATCHES "^(..)(..)(..)(..)$")
    message(FATAL_ERROR "The ${product_name} image has no valid DOS header.")
endif()

math(EXPR pe_offset "0x${CMAKE_MATCH_4}${CMAKE_MATCH_3}${CMAKE_MATCH_2}${CMAKE_MATCH_1}")
math(EXPR pe_header_end "${pe_offset} + 26")
if(pe_offset LESS 64 OR pe_header_end GREATER image_size)
    message(FATAL_ERROR "The ${product_name} image has an invalid PE header offset.")
endif()

file(READ "${image}" pe_signature_and_machine OFFSET ${pe_offset} LIMIT 6 HEX)
if(NOT pe_signature_and_machine STREQUAL "504500004c01")
    message(FATAL_ERROR
        "Expected an x86 PE image for ${product_name}, found header '${pe_signature_and_machine}'.")
endif()

math(EXPR optional_magic_offset "${pe_offset} + 24")
math(EXPR optional_size_offset "${pe_offset} + 20")
file(READ "${image}" optional_size_bytes OFFSET ${optional_size_offset} LIMIT 2 HEX)
if(NOT optional_size_bytes MATCHES "^(..)(..)$")
    message(FATAL_ERROR "The ${product_name} image has a truncated COFF header.")
endif()
math(EXPR optional_size "0x${CMAKE_MATCH_2}${CMAKE_MATCH_1}")
math(EXPR optional_header_end "${optional_magic_offset} + ${optional_size}")
# A PE32 image has 96 bytes of fixed optional-header fields before its data directories.
if(optional_size LESS 96 OR optional_header_end GREATER image_size)
    message(FATAL_ERROR "The ${product_name} image has an invalid PE32 optional header length.")
endif()
file(READ "${image}" optional_magic OFFSET ${optional_magic_offset} LIMIT 2 HEX)
if(NOT optional_magic STREQUAL "0b01")
    message(FATAL_ERROR
        "Expected a PE32 optional header for ${product_name}, found '${optional_magic}'.")
endif()

math(EXPR characteristics_offset "${pe_offset} + 22")
file(READ "${image}" characteristics_bytes OFFSET ${characteristics_offset} LIMIT 2 HEX)
if(NOT characteristics_bytes MATCHES "^(..)(..)$")
    message(FATAL_ERROR "The ${product_name} image has a truncated COFF header.")
endif()
math(EXPR characteristics "0x${CMAKE_MATCH_2}${CMAKE_MATCH_1}")
math(EXPR dll_flag "${characteristics} & 0x2000")
if(dll_flag EQUAL 0)
    message(FATAL_ERROR "The ${product_name} image is not marked as a Windows DLL.")
endif()
