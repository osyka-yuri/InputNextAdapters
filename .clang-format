# Formatter version: tools/llvm-version.txt
BasedOnStyle: LLVM
Language: Cpp
Standard: c++23

# Layout
IndentWidth: 4
ContinuationIndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100
LineEnding: LF
InsertNewlineAtEOF: true
AlignAfterOpenBracket: false
BreakBeforeBraces: Attach
SpaceBeforeParens: ControlStatements
SpacesInParens: Never
SpacesInAngles: Never
Cpp11BracedListStyle: FunctionCall

# Types, pointers and class members
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Left
QualifierAlignment: Leave
IndentAccessModifiers: false
AccessModifierOffset: -4
NamespaceIndentation: None
FixNamespaceComments: true

# Templates, concepts and requires
BreakTemplateDeclarations: Yes
BreakBeforeConceptDeclarations: Always
RequiresClausePosition: OwnLine
IndentRequiresClause: false
RequiresExpressionIndentation: OuterScope
AllowShortCompoundRequirementOnASingleLine: true

# Function calls, declarations and constructors
PackArguments:
  BinPack: OnePerLine
PackParameters:
  BinPack: OnePerLine
PackConstructorInitializers: CurrentLine
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false

# Short constructs
AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortLambdasOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortRecordOnASingleLine: Empty

# Alignment and definition spacing
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
SeparateDefinitionBlocks: Always
MaxEmptyLinesToKeep: 1
KeepEmptyLines:
  AtStartOfFile: false
  AtEndOfFile: false
  AtStartOfBlock: false

# Includes and preprocessor
SortIncludes:
  Enabled: true
  IgnoreCase: false
  IgnoreExtension: false
IncludeBlocks: Preserve
IndentPPDirectives: AfterHash

# Comments
ReflowComments: IndentOnly
