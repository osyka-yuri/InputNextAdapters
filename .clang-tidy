# EnumCastOutOfRange rejects valid bitmask combinations.
Checks: >
  -*,
  bugprone-*,
  cert-err33-c,
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  concurrency-thread-canceltype-asynchronous,
  cppcoreguidelines-avoid-capturing-lambda-coroutines,
  cppcoreguidelines-avoid-goto,
  cppcoreguidelines-avoid-reference-coroutine-parameters,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-interfaces-global-init,
  cppcoreguidelines-macro-usage,
  cppcoreguidelines-misleading-capture-default-by-value,
  cppcoreguidelines-missing-std-forward,
  cppcoreguidelines-no-suspend-with-lock,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-pro-type-const-cast,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-pro-type-union-access,
  cppcoreguidelines-rvalue-reference-param-not-moved,
  cppcoreguidelines-slicing,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-use-enum-class,
  cppcoreguidelines-virtual-class-destructor,
  misc-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-trailing-comma

CheckOptions:
  bugprone-exception-escape.FunctionsThatShouldNotThrow: 'wmain'
  bugprone-unhandled-self-assignment.WarnOnlyIfThisHasSuspiciousField: 'false'
  misc-const-correctness.AllowedTypes: 'scoped_lock;unique_lock;shared_lock;lock_guard;BSAutoLock'
  misc-include-cleaner.IgnoreHeaders: '(^|[/\\])Windows\.h;[/\\]Windows Kits[/\\]10[/\\]Include[/\\][^/\\]+[/\\](um|shared)[/\\].*'
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: 'true'
  performance-enum-size.EnumIgnoreList: '::inputnext::adapters::ConnectError;::skyrim_adapter::EffectId;::skyrim_adapter::TriggerId;::skyrim_adapter::HitFlag'
  readability-function-cognitive-complexity.IgnoreMacros: 'true'
  readability-identifier-length.IgnoredParameterNames: '^(id|n)$'
  readability-identifier-length.IgnoredVariableNames: '^(dx|dy|dz|t|t0|ec|id)$'
  readability-implicit-bool-conversion.AllowIntegerConditions: 'true'
  readability-implicit-bool-conversion.AllowPointerConditions: 'true'
  readability-simplify-boolean-expr.IgnoreMacros: 'true'

WarningsAsErrors: '*'

HeaderFilterRegex: '.*[/\\](adapters|include|inputnext_adapters|src|tests|examples|tools|sdk)[/\\]'
ExcludeHeaderFilterRegex: '.*[/\\](third_party|build)[/\\]'

SystemHeaders: false
InheritParentConfig: false
FormatStyle: none
