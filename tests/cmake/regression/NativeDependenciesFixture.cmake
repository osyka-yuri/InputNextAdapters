cmake_minimum_required(VERSION 4.4.4)

foreach(_required IN ITEMS HELPER_SOURCE_DIR WORK_ROOT)
    if(NOT DEFINED ${_required})
        message(FATAL_ERROR "${_required} is required.")
    endif()
endforeach()

include("${HELPER_SOURCE_DIR}/cmake/NativeDependencies.cmake")
include("${HELPER_SOURCE_DIR}/cmake/DependencySources.cmake")

if(TEST_WRONG_PIN)
    inputnext_native_dependency_names(fallout4 _names)
    set(_dependencies)
    set(_first TRUE)
    foreach(_name IN LISTS _names)
        inputnext_native_dependency_metadata(fallout4 "${_name}" _metadata)
        set(_revision "${_metadata_REVISION}")
        if(_first)
            string(SUBSTRING "${_revision}" 1 -1 _revision_tail)
            string(SUBSTRING "${_revision}" 0 1 _revision_first)
            if(_revision_first STREQUAL "0")
                set(_revision_first "1")
            else()
                set(_revision_first "0")
            endif()
            set(_revision "${_revision_first}${_revision_tail}")
            set(_first FALSE)
        endif()
        _inputnext_json_quote(_name_json "${_name}")
        _inputnext_json_quote(_repository_json "${_metadata_REPOSITORY}")
        _inputnext_json_quote(_revision_json "${_revision}")
        _inputnext_json_quote(_path_json "${_metadata_PATH}")
        _inputnext_json_quote(_fetch_content_json "${_metadata_FETCHCONTENT}")
        if(_dependencies)
            string(APPEND _dependencies ",")
        endif()
        string(APPEND _dependencies
            "{\"name\":${_name_json},\"repository\":${_repository_json},\"revision\":${_revision_json},\"path\":${_path_json},\"fetchContent\":${_fetch_content_json},\"patches\":[],\"submodules\":[],\"files\":[]}")
    endforeach()
    file(MAKE_DIRECTORY "${WORK_ROOT}")
    set(_manifest "${WORK_ROOT}/inputnext-adapters-source.json")
    file(WRITE "${_manifest}"
        "{\"schemaVersion\":1,\"kind\":\"inputnext-adapters-source-bundle\",\"product\":\"fallout4\",\"dependencies\":[${_dependencies}]}\n")
    set(INPUTNEXTADAPTERS_SOURCE_BUNDLE "${_manifest}")
    set(INPUTNEXTADAPTERS_RELEASE_BUILD OFF)
    inputnext_prepare_dependency_sources(fallout4)
    message(FATAL_ERROR "A source bundle with a catalog-mismatched native pin was accepted.")
endif()

file(READ "${HELPER_SOURCE_DIR}/cmake/NativeDependencies.json" _catalog)
string(JSON _product_count LENGTH "${_catalog}" products)
foreach(_product_index RANGE 0 ${_product_count})
    if(_product_index GREATER_EQUAL _product_count)
        break()
    endif()
    string(JSON _product GET "${_catalog}" products ${_product_index} name)
    string(JSON _dependency_count LENGTH "${_catalog}" products ${_product_index} dependencies)
    set(_expected_names "")
    set(_expected_specs "")
    set(_expected_patches "")
    set(_expected_submodules "")
    foreach(_dependency_index RANGE 0 ${_dependency_count})
        if(_dependency_index GREATER_EQUAL _dependency_count)
            break()
        endif()
        foreach(_field IN ITEMS name repository revision path fetchContent)
            string(JSON _${_field} GET "${_catalog}"
                products ${_product_index} dependencies ${_dependency_index} ${_field})
        endforeach()
        list(APPEND _expected_names "${_name}")
        list(APPEND _expected_specs "${_name}|${_repository}|${_revision}|${_path}|${_fetchContent}")
        set(_dependency_name "${_name}")
        string(JSON _submodule_count LENGTH "${_catalog}"
            products ${_product_index} dependencies ${_dependency_index} submodules)
        foreach(_submodule_index RANGE 0 ${_submodule_count})
            if(_submodule_index GREATER_EQUAL _submodule_count)
                break()
            endif()
            foreach(_field IN ITEMS name path repository revision)
                string(JSON _submodule_${_field} GET "${_catalog}"
                    products ${_product_index} dependencies ${_dependency_index}
                    submodules ${_submodule_index} ${_field})
            endforeach()
            list(APPEND _expected_submodules
                "${_dependency_name}|${_submodule_name}|${_submodule_path}|${_submodule_repository}|${_submodule_revision}")
        endforeach()
        string(JSON _patch_count LENGTH "${_catalog}"
            products ${_product_index} dependencies ${_dependency_index} patches)
        foreach(_patch_index RANGE 0 ${_patch_count})
            if(_patch_index GREATER_EQUAL _patch_count)
                break()
            endif()
            foreach(_field IN ITEMS id path)
                string(JSON _patch_${_field} GET "${_catalog}"
                    products ${_product_index} dependencies ${_dependency_index}
                    patches ${_patch_index} ${_field})
            endforeach()
            foreach(_newline IN ITEMS lf crlf)
                string(JSON _output_${_newline} GET "${_catalog}"
                    products ${_product_index} dependencies ${_dependency_index}
                    patches ${_patch_index} outputSha256 ${_newline})
            endforeach()
            list(APPEND _expected_patches
                "${_dependency_name}|${_patch_id}|${_patch_path}|${_output_lf},${_output_crlf}")
        endforeach()
    endforeach()
    inputnext_native_dependency_names("${_product}" _actual_names)
    inputnext_native_dependency_specs("${_product}" _actual_specs _patch_specs _submodule_specs)
    if(NOT "${_actual_names}" STREQUAL "${_expected_names}" OR
       NOT "${_actual_specs}" STREQUAL "${_expected_specs}" OR
       NOT "${_patch_specs}" STREQUAL "${_expected_patches}" OR
       NOT "${_submodule_specs}" STREQUAL "${_expected_submodules}")
        message(FATAL_ERROR "Catalog fields were not preserved in CMake metadata for '${_product}'.")
    endif()
endforeach()

message(STATUS "Native dependency catalog positive checks passed.")
