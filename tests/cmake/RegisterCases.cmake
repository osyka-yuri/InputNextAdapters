include_guard(GLOBAL)

function(inputnext_register_case_tests)
    cmake_parse_arguments(PARSE_ARGV 0 cases "" "TARGET;PREFIX;MANIFEST" "ARGS;LABELS")
    if(cases_UNPARSED_ARGUMENTS OR cases_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid test case registration arguments")
    endif()
    foreach(required IN ITEMS TARGET PREFIX MANIFEST)
        if(NOT cases_${required})
            message(FATAL_ERROR "Case registration requires ${required}")
        endif()
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${cases_MANIFEST}")
    file(STRINGS "${cases_MANIFEST}" entries REGEX "^INPUTNEXT_TEST_CASE\\(")
    set(registered_ids)
    foreach(entry IN LISTS entries)
        if(NOT entry MATCHES "^INPUTNEXT_TEST_CASE\\(([a-z][a-z0-9_]*),")
            message(FATAL_ERROR "Invalid test case manifest entry: ${entry}")
        endif()
        set(case_id "${CMAKE_MATCH_1}")
        if(case_id IN_LIST registered_ids)
            message(FATAL_ERROR "Duplicate test case id: ${case_id}")
        endif()
        list(APPEND registered_ids "${case_id}")
        add_test(NAME "${cases_PREFIX}.case.${case_id}"
            COMMAND "${cases_TARGET}" ${cases_ARGS} --case "${case_id}")
        if(cases_LABELS)
            set_tests_properties("${cases_PREFIX}.case.${case_id}" PROPERTIES
                LABELS "${cases_LABELS}"
            )
        endif()
    endforeach()
    if(NOT registered_ids)
        message(FATAL_ERROR "Empty test case manifest: ${cases_MANIFEST}")
    endif()
endfunction()
