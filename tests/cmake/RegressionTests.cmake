cmake_minimum_required(VERSION 4.4.4)

foreach(required INPUTNEXTADAPTERS_BINARY_DIR INPUTNEXTADAPTERS_SOURCE_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required.")
    endif()
endforeach()

file(TO_CMAKE_PATH "${INPUTNEXTADAPTERS_SOURCE_DIR}" INPUTNEXTADAPTERS_SOURCE_DIR)
file(TO_CMAKE_PATH "${INPUTNEXTADAPTERS_BINARY_DIR}" INPUTNEXTADAPTERS_BINARY_DIR)
get_filename_component(INPUTNEXTADAPTERS_SOURCE_DIR "${INPUTNEXTADAPTERS_SOURCE_DIR}" REALPATH)
get_filename_component(INPUTNEXTADAPTERS_BINARY_DIR "${INPUTNEXTADAPTERS_BINARY_DIR}" REALPATH)
include("${INPUTNEXTADAPTERS_SOURCE_DIR}/tests/cmake/VerifyConsumerLogic.cmake")

set(sandbox "${INPUTNEXTADAPTERS_BINARY_DIR}/regression_tests_sandbox")
function(_regression_reset_sandbox sandbox binary_root create_sandbox)
    get_filename_component(expected_sandbox "${binary_root}/regression_tests_sandbox" REALPATH)
    get_filename_component(binary_root "${binary_root}" REALPATH)
    get_filename_component(sandbox_parent "${sandbox}" DIRECTORY)
    get_filename_component(sandbox_parent "${sandbox_parent}" REALPATH)
    get_filename_component(sandbox_name "${sandbox}" NAME)
    if(NOT sandbox_name STREQUAL "regression_tests_sandbox" OR
       NOT sandbox_parent STREQUAL binary_root OR
       IS_SYMLINK "${sandbox}")
        message(FATAL_ERROR "Refusing to clean a regression sandbox outside its derived binary-directory path.")
    endif()
    if(EXISTS "${sandbox}")
        get_filename_component(resolved_sandbox "${sandbox}" REALPATH)
        if(NOT resolved_sandbox STREQUAL expected_sandbox OR sandbox STREQUAL binary_root)
            message(FATAL_ERROR "Refusing to clean redirected regression sandbox '${sandbox}'.")
        endif()
        file(REMOVE_RECURSE "${sandbox}")
    endif()
    if(create_sandbox)
        file(MAKE_DIRECTORY "${sandbox}")
    endif()
endfunction()

_regression_reset_sandbox("${sandbox}" "${INPUTNEXTADAPTERS_BINARY_DIR}" TRUE)

include("${CMAKE_CURRENT_LIST_DIR}/regression/ConfigTests.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/regression/AnalyzeTests.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/regression/ConsumerPrefixTests.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/regression/TargetOptionsTests.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/regression/VendorOptionsTests.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/regression/ClangTidyConfigTests.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/regression/InputNextPinTests.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/regression/PackageProbeTests.cmake")

_regression_reset_sandbox("${sandbox}" "${INPUTNEXTADAPTERS_BINARY_DIR}" FALSE)
message(STATUS "[RegressionTest] All CMake build system regression checks passed successfully.")
