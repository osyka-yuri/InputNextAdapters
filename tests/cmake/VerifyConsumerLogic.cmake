include_guard(GLOBAL)

function(_inputnext_real_path path out_path)
    file(TO_CMAKE_PATH "${path}" input_path)
    if(input_path MATCHES "^[A-Za-z]:[^/]")
        message(FATAL_ERROR "Cannot safely resolve drive-relative path '${input_path}'.")
    endif()
    if(IS_ABSOLUTE "${input_path}")
        set(absolute_input_path "${input_path}")
    else()
        set(absolute_input_path "${CMAKE_CURRENT_BINARY_DIR}/${input_path}")
    endif()

    if(EXISTS "${absolute_input_path}")
        file(REAL_PATH "${absolute_input_path}" resolved_path BASE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}")
    else()
        if(absolute_input_path MATCHES "(^|/)\\.\\.(/|$)")
            message(FATAL_ERROR "Cannot safely resolve missing path '${absolute_input_path}' with parent-directory traversal.")
        endif()
        set(candidate_path "${absolute_input_path}")
        file(TO_CMAKE_PATH "${candidate_path}" candidate_path)
        set(missing_suffix "")
        while(NOT EXISTS "${candidate_path}")
            if(IS_SYMLINK "${candidate_path}")
                message(FATAL_ERROR "Cannot safely resolve path through dangling symbolic link '${candidate_path}'.")
            endif()
            get_filename_component(missing_component "${candidate_path}" NAME)
            get_filename_component(parent_path "${candidate_path}" DIRECTORY)
            if(missing_component STREQUAL "" OR parent_path STREQUAL candidate_path)
                message(FATAL_ERROR "Cannot find an existing parent while resolving path '${absolute_input_path}'.")
            endif()
            set(missing_suffix "${missing_component}/${missing_suffix}")
            set(candidate_path "${parent_path}")
        endwhile()
        if(NOT missing_suffix STREQUAL "" AND NOT IS_DIRECTORY "${candidate_path}")
            message(FATAL_ERROR "Cannot resolve missing path '${absolute_input_path}' below non-directory '${candidate_path}'.")
        endif()
        file(REAL_PATH "${candidate_path}" resolved_path BASE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}")
        if(NOT missing_suffix STREQUAL "")
            file(TO_CMAKE_PATH "${resolved_path}" resolved_path)
            if(resolved_path MATCHES "/$")
                string(APPEND resolved_path "${missing_suffix}")
            else()
                string(APPEND resolved_path "/${missing_suffix}")
            endif()
        endif()
    endif()
    file(TO_CMAKE_PATH "${resolved_path}" resolved_path)
    string(REGEX REPLACE "/+$" "" resolved_path "${resolved_path}")
    if(resolved_path STREQUAL "")
        set(resolved_path "/")
    endif()
    set(${out_path} "${resolved_path}" PARENT_SCOPE)
endfunction()

function(_inputnext_path_is_within path root out_is_within)
    _inputnext_real_path("${path}" path_real)
    _inputnext_real_path("${root}" root_real)
    if(WIN32)
        string(TOLOWER "${path_real}" path_compare)
        string(TOLOWER "${root_real}" root_compare)
    else()
        set(path_compare "${path_real}")
        set(root_compare "${root_real}")
    endif()

    set(is_within FALSE)
    if(path_compare STREQUAL root_compare)
        set(is_within TRUE)
    else()
        if(root_compare MATCHES "/$")
            set(root_prefix "${root_compare}")
        else()
            set(root_prefix "${root_compare}/")
        endif()
        string(FIND "${path_compare}" "${root_prefix}" prefix_position)
        if(prefix_position EQUAL 0)
            set(is_within TRUE)
        endif()
    endif()
    set(${out_is_within} "${is_within}" PARENT_SCOPE)
endfunction()

function(inputnext_prepare_consumer_directory binary_directory mode consumer out_binary out_integration out_consumer)
    if(NOT mode MATCHES "^(add_subdirectory|installed)$" OR
       NOT consumer MATCHES "^(effects_probe|common_effects)$")
        message(FATAL_ERROR "Cannot derive a consumer directory from mode '${mode}' and consumer '${consumer}'.")
    endif()

    _inputnext_real_path("${binary_directory}" binary_root)
    if(NOT IS_DIRECTORY "${binary_root}")
        message(FATAL_ERROR "The consumer binary root is not a directory: ${binary_root}")
    endif()
    set(integration_root "${binary_root}/integration")
    set(mode_root "${integration_root}/${mode}")
    set(consumer_root "${mode_root}/${consumer}")

    foreach(path "${integration_root}" "${mode_root}" "${consumer_root}")
        if(IS_SYMLINK "${path}")
            message(FATAL_ERROR "Refusing to use redirected consumer directory '${path}'.")
        endif()
    endforeach()
    _inputnext_path_is_within("${integration_root}" "${binary_root}" integration_is_owned)
    _inputnext_path_is_within("${consumer_root}" "${integration_root}" consumer_is_owned)
    if(NOT integration_is_owned OR integration_root STREQUAL binary_root OR
       NOT consumer_is_owned OR consumer_root STREQUAL integration_root)
        message(FATAL_ERROR "The derived consumer directory escapes its validated binary/integration root.")
    endif()

    file(MAKE_DIRECTORY "${consumer_root}")
    _inputnext_real_path("${integration_root}" integration_root)
    _inputnext_real_path("${consumer_root}" consumer_root)
    _inputnext_path_is_within("${integration_root}" "${binary_root}" integration_is_owned)
    _inputnext_path_is_within("${consumer_root}" "${integration_root}" consumer_is_owned)
    if(NOT integration_is_owned OR NOT consumer_is_owned)
        message(FATAL_ERROR "The created consumer directory resolved outside its validated root.")
    endif()

    set(${out_binary} "${binary_root}" PARENT_SCOPE)
    set(${out_integration} "${integration_root}" PARENT_SCOPE)
    set(${out_consumer} "${consumer_root}" PARENT_SCOPE)
endfunction()

function(inputnext_assert_paths_disjoint source_path destination_path description)
    _inputnext_path_is_within("${source_path}" "${destination_path}" source_within_destination)
    _inputnext_path_is_within("${destination_path}" "${source_path}" destination_within_source)
    if(source_within_destination OR destination_within_source)
        message(FATAL_ERROR "Refusing ${description}: source '${source_path}' and destination '${destination_path}' overlap.")
    endif()
endfunction()

function(inputnext_assert_removal_preserves_path removal_path protected_path description)
    _inputnext_path_is_within("${protected_path}" "${removal_path}" protected_path_would_be_removed)
    if(protected_path_would_be_removed)
        message(FATAL_ERROR "Refusing ${description}: removal path '${removal_path}' contains protected path '${protected_path}'.")
    endif()
endfunction()

function(inputnext_remove_owned_package_prefix prefix_path binary_root integration_root consumer_root)
    get_filename_component(prefix_name "${prefix_path}" NAME)
    get_filename_component(prefix_parent "${prefix_path}" DIRECTORY)
    _inputnext_real_path("${prefix_path}" prefix_real)
    _inputnext_real_path("${consumer_root}" consumer_real)
    _inputnext_real_path("${prefix_parent}" parent_real)

    if(NOT prefix_name MATCHES "^(install-prefix|relocated-prefix)$" OR
       NOT parent_real STREQUAL consumer_real)
        message(FATAL_ERROR "Refusing to remove non-owned package prefix '${prefix_path}'.")
    endif()
    _inputnext_path_is_within("${integration_root}" "${binary_root}" integration_is_owned)
    _inputnext_path_is_within("${consumer_root}" "${integration_root}" consumer_is_owned)
    _inputnext_path_is_within("${prefix_real}" "${consumer_real}" prefix_is_owned)
    if(NOT integration_is_owned OR integration_root STREQUAL binary_root OR
       NOT consumer_is_owned OR consumer_root STREQUAL integration_root OR
       NOT prefix_is_owned OR prefix_real STREQUAL consumer_real)
        message(FATAL_ERROR "Refusing to remove '${prefix_path}' because its resolved path escapes the validated consumer root.")
    endif()

    set(path_cursor "${prefix_path}")
    while(1)
        if(IS_SYMLINK "${path_cursor}")
            message(FATAL_ERROR "Refusing to remove redirected or symbolic-link package path '${path_cursor}'.")
        endif()
        _inputnext_real_path("${path_cursor}" cursor_real)
        if(NOT cursor_real STREQUAL path_cursor)
            message(FATAL_ERROR "Refusing to remove redirected package path '${path_cursor}'.")
        endif()
        if(path_cursor STREQUAL binary_root)
            break()
        endif()
        get_filename_component(parent_cursor "${path_cursor}" DIRECTORY)
        if(parent_cursor STREQUAL path_cursor)
            message(FATAL_ERROR "The package removal path is not rooted under '${binary_root}'.")
        endif()
        set(path_cursor "${parent_cursor}")
    endwhile()

    file(REMOVE_RECURSE "${prefix_path}")
endfunction()

function(inputnext_relocate_install_prefix source_prefix relocated_prefix binary_root integration_root consumer_root)
    if(NOT IS_DIRECTORY "${source_prefix}")
        message(FATAL_ERROR "The package install prefix is not a directory: ${source_prefix}")
    endif()
    inputnext_assert_paths_disjoint("${source_prefix}" "${relocated_prefix}" "relocated package verification")
    inputnext_remove_owned_package_prefix("${relocated_prefix}" "${binary_root}" "${integration_root}" "${consumer_root}")
    file(COPY "${source_prefix}/" DESTINATION "${relocated_prefix}")
endfunction()

function(_is_msvc_analyze_effective command_line out_enabled)
    set(${out_enabled} FALSE PARENT_SCOPE)
    if(NOT command_line MATCHES "[ \t/-]analyze(:[a-z0-9_]+)?([ \t\r\n]|$)")
        return()
    endif()
    if(NOT command_line MATCHES "[ \t/-]analyze-([ \t\r\n]|$)")
        set(${out_enabled} TRUE PARENT_SCOPE)
        return()
    endif()
    string(REGEX REPLACE "[ \t/-]analyze-([ \t\r\n]|$)" " __ANALYZE_OFF__ " tokenized_command "${command_line}")
    string(REGEX REPLACE "[ \t/-]analyze(:[a-z0-9_]+)?([ \t\r\n]|$)" " __ANALYZE_ON__ " tokenized_command "${tokenized_command}")
    string(FIND "${tokenized_command}" "__ANALYZE_ON__" last_on REVERSE)
    string(FIND "${tokenized_command}" "__ANALYZE_OFF__" last_off REVERSE)
    if(last_on GREATER last_off)
        set(${out_enabled} TRUE PARENT_SCOPE)
    endif()
endfunction()

function(_inputnext_object_matches_target object_path target_identity out_matches)
    string(REPLACE "\\" "/" normalized_object "${object_path}")
    set(matches FALSE)
    if(normalized_object MATCHES "(^|/)CMakeFiles/([^/]+)\\.dir(/|$)")
        set(object_owner "${CMAKE_MATCH_2}")
        if(object_owner STREQUAL target_identity)
            set(matches TRUE)
        endif()
    endif()
    set(${out_matches} "${matches}" PARENT_SCOPE)
endfunction()

function(_inputnext_extract_fo_path command_line out_path)
    set(${out_path} "" PARENT_SCOPE)
    if(command_line MATCHES [=[(^|[ \t])(/Fo|-Fo)[ \t]+("[^"]+"|[^ \t]+)]=])
        set(object_path "${CMAKE_MATCH_3}")
        if(object_path MATCHES "^\"(.*)\"$")
            set(object_path "${CMAKE_MATCH_1}")
        endif()
        set(${out_path} "${object_path}" PARENT_SCOPE)
        return()
    endif()
    if(command_line MATCHES "(^|[ \t])(/Fo|-Fo)(\"[^\"]+\"|[^ \t]+)")
        set(object_path "${CMAKE_MATCH_3}")
        if(object_path MATCHES "^\"(.*)\"$")
            set(object_path "${CMAKE_MATCH_1}")
        endif()
        set(${out_path} "${object_path}" PARENT_SCOPE)
    endif()
endfunction()

function(_inputnext_object_configuration object_path command_line target_identity out_configuration)
    string(REPLACE "\\" "/" normalized_object "${object_path}")
    set(configuration "")
    if(normalized_object MATCHES "(^|/)CMakeFiles/([^/]+)\\.dir/([^/]+)/")
        set(object_owner "${CMAKE_MATCH_2}")
        if(object_owner STREQUAL target_identity)
            set(configuration "${CMAKE_MATCH_3}")
        endif()
    elseif(command_line MATCHES "CMAKE_INTDIR[ \t]*=[ \t]*\"?([^ \t\";]+)")
        set(configuration "${CMAKE_MATCH_1}")
    endif()
    set(${out_configuration} "${configuration}" PARENT_SCOPE)
endfunction()

function(_inputnext_build_configuration_info build_directory out_is_multi out_configurations out_build_type)
    set(is_multi FALSE)
    set(configurations "")
    set(build_type "")
    set(cache_path "${build_directory}/CMakeCache.txt")
    if(EXISTS "${cache_path}")
        file(STRINGS "${cache_path}" configuration_entry REGEX "^CMAKE_CONFIGURATION_TYPES:")
        if(configuration_entry MATCHES "^[^=]*=(.+)$")
            set(configurations "${CMAKE_MATCH_1}")
            set(is_multi TRUE)
        endif()
        if(NOT is_multi)
            file(STRINGS "${cache_path}" generator_entry REGEX "^CMAKE_GENERATOR:INTERNAL=")
            if(generator_entry MATCHES "Visual Studio|Xcode|Ninja Multi-Config")
                set(is_multi TRUE)
            endif()
        endif()
        if(NOT is_multi)
            file(STRINGS "${cache_path}" build_type_entry REGEX "^CMAKE_BUILD_TYPE:STRING=")
            if(build_type_entry MATCHES "^CMAKE_BUILD_TYPE:STRING=(.*)$")
                set(build_type "${CMAKE_MATCH_1}")
            endif()
        endif()
    endif()
    set(${out_is_multi} "${is_multi}" PARENT_SCOPE)
    set(${out_configurations} "${configurations}" PARENT_SCOPE)
    set(${out_build_type} "${build_type}" PARENT_SCOPE)
endfunction()

function(_inputnext_configuration_matches object_path command_line target_identity is_multi known_configuration build_type requested_configuration out_matches)
    set(matches TRUE)
    if(NOT requested_configuration STREQUAL "")
        if(NOT known_configuration STREQUAL "")
            if(NOT known_configuration STREQUAL requested_configuration)
                set(matches FALSE)
            endif()
        elseif(is_multi)
            _inputnext_object_configuration("${object_path}" "${command_line}" "${target_identity}" object_configuration)
            if(object_configuration STREQUAL "")
                message(FATAL_ERROR "Cannot identify the configuration of ${target_identity}'s selected object '${object_path}'.")
            elseif(NOT object_configuration STREQUAL requested_configuration)
                set(matches FALSE)
            endif()
        elseif(NOT build_type STREQUAL requested_configuration)
            if(build_type STREQUAL "")
                message(FATAL_ERROR "Cannot verify requested configuration '${requested_configuration}' for single-config target ${target_identity}: CMakeCache.txt has no CMAKE_BUILD_TYPE.")
            endif()
            set(matches FALSE)
        endif()
    endif()
    set(${out_matches} "${matches}" PARENT_SCOPE)
endfunction()

function(_inputnext_object_paths_equal left_path right_path base_directory out_equal)
    get_filename_component(left_absolute "${left_path}" ABSOLUTE BASE_DIR "${base_directory}")
    get_filename_component(right_absolute "${right_path}" ABSOLUTE BASE_DIR "${base_directory}")
    file(TO_CMAKE_PATH "${left_absolute}" left_absolute)
    file(TO_CMAKE_PATH "${right_absolute}" right_absolute)
    if(WIN32)
        string(TOLOWER "${left_absolute}" left_absolute)
        string(TOLOWER "${right_absolute}" right_absolute)
    endif()
    if(left_absolute STREQUAL right_absolute)
        set(${out_equal} TRUE PARENT_SCOPE)
    else()
        set(${out_equal} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(_inputnext_ninja_stanza_command build_lines build_directory selected_object out_command)
    set(${out_command} "" PARENT_SCOPE)
    set(in_selected_stanza FALSE)
    set(selected_rule "")
    set(selected_inputs "")
    set(selected_flags "")
    set(selected_defines "")
    set(selected_includes "")

    foreach(line IN LISTS build_lines)
        if(line MATCHES "^build[ \t]+([^:]+):[ \t]*([^ \t]+)[ \t]*(.*)$")
            set(output_list "${CMAKE_MATCH_1}")
            set(edge_rule "${CMAKE_MATCH_2}")
            set(edge_inputs "${CMAKE_MATCH_3}")
            string(FIND "${edge_inputs}" "|" implicit_input_position)
            if(NOT implicit_input_position EQUAL -1)
                string(SUBSTRING "${edge_inputs}" 0 ${implicit_input_position} edge_inputs)
                string(STRIP "${edge_inputs}" edge_inputs)
            endif()
            set(in_selected_stanza FALSE)
            foreach(output IN LISTS output_list)
                _inputnext_object_paths_equal("${output}" "${selected_object}" "${build_directory}" same_object)
                if(same_object)
                    set(in_selected_stanza TRUE)
                    set(selected_rule "${edge_rule}")
                    set(selected_inputs "${edge_inputs}")
                    break()
                endif()
            endforeach()
        elseif(line MATCHES "^(build|rule|pool|default|include|subninja)[ \t]")
            set(in_selected_stanza FALSE)
        elseif(in_selected_stanza)
            if(line MATCHES "^[ \t]*FLAGS[ \t]*=[ \t]*(.*)$")
                set(selected_flags "${CMAKE_MATCH_1}")
            elseif(line MATCHES "^[ \t]*DEFINES[ \t]*=[ \t]*(.*)$")
                set(selected_defines "${CMAKE_MATCH_1}")
            elseif(line MATCHES "^[ \t]*INCLUDES[ \t]*=[ \t]*(.*)$")
                set(selected_includes "${CMAKE_MATCH_1}")
            endif()
        endif()
    endforeach()

    if(selected_rule STREQUAL "")
        return()
    endif()
    set(rule_command "")
    set(in_selected_rule FALSE)
    foreach(line IN LISTS build_lines)
        if(line MATCHES "^rule[ \t]+${selected_rule}$")
            set(in_selected_rule TRUE)
        elseif(line MATCHES "^(rule|build|pool|default|include|subninja)[ \t]")
            set(in_selected_rule FALSE)
        elseif(in_selected_rule AND line MATCHES "^[ \t]*command[ \t]*=[ \t]*(.*)$")
            set(rule_command "${CMAKE_MATCH_1}")
            break()
        endif()
    endforeach()
    if(rule_command STREQUAL "")
        return()
    endif()

    string(REPLACE "\$FLAGS" "${selected_flags}" command "${rule_command}")
    string(REPLACE "\$DEFINES" "${selected_defines}" command "${command}")
    string(REPLACE "\$INCLUDES" "${selected_includes}" command "${command}")
    string(REPLACE "\$out" "${selected_object}" command "${command}")
    string(REPLACE "\$in" "${selected_inputs}" command "${command}")
    set(${out_command} "${command}" PARENT_SCOPE)
endfunction()

function(_inputnext_ninja_command build_file build_directory selected_object out_command)
    set(${out_command} "" PARENT_SCOPE)
    find_program(NINJA_COMMAND NAMES ninja ninja-build)
    if(NOT NINJA_COMMAND AND EXISTS "${build_directory}/CMakeCache.txt")
        file(STRINGS "${build_directory}/CMakeCache.txt" make_program_entry REGEX "^CMAKE_MAKE_PROGRAM:")
        if(make_program_entry MATCHES "[Nn]inja(-build)?([.]exe)?$")
            string(REGEX REPLACE "^[^=]*=" "" configured_ninja "${make_program_entry}")
            if(EXISTS "${configured_ninja}")
                set(NINJA_COMMAND "${configured_ninja}")
            endif()
        endif()
    endif()
    if(NINJA_COMMAND)
        get_filename_component(build_file_name "${build_file}" NAME)
        if(build_file_name STREQUAL "build.ninja")
            execute_process(
                COMMAND "${NINJA_COMMAND}" -C "${build_directory}" -t commands "${selected_object}"
                RESULT_VARIABLE ninja_result
                OUTPUT_VARIABLE expanded_commands
                ERROR_QUIET
            )
        else()
            execute_process(
                COMMAND "${NINJA_COMMAND}" -C "${build_directory}" -f "${build_file_name}" -t commands "${selected_object}"
                RESULT_VARIABLE ninja_result
                OUTPUT_VARIABLE expanded_commands
                ERROR_QUIET
            )
        endif()
        if(ninja_result EQUAL 0)
            string(REPLACE "\r" "" expanded_commands "${expanded_commands}")
            string(REPLACE "\n" ";" command_lines "${expanded_commands}")
            set(matched_command "")
            foreach(command_line IN LISTS command_lines)
                _inputnext_extract_fo_path("${command_line}" command_object)
                if(NOT command_object STREQUAL "")
                    _inputnext_object_paths_equal("${command_object}" "${selected_object}" "${build_directory}" same_object)
                    if(same_object)
                        if(NOT matched_command STREQUAL "")
                            message(FATAL_ERROR "Ninja returned multiple compile commands for selected object '${selected_object}'.")
                        endif()
                        set(matched_command "${command_line}")
                    endif()
                endif()
            endforeach()
            if(NOT matched_command STREQUAL "")
                set(${out_command} "${matched_command}" PARENT_SCOPE)
                return()
            endif()
        endif()
    endif()

    _inputnext_ninja_stanza_command("${build_lines}" "${build_directory}" "${selected_object}" stanza_command)
    set(${out_command} "${stanza_command}" PARENT_SCOPE)
endfunction()

function(_inputnext_check_ninja_file build_file command_file build_directory source_pattern target_identity requested_configuration is_multi known_configuration build_type)
    file(STRINGS "${build_file}" build_lines)
    set(selected_objects "")
    set(target_source_count 0)

    foreach(line IN LISTS build_lines)
        if(line MATCHES "^build[ \t]+([^:]+):[ \t]*[^ \t]+[ \t]+(.*)$")
            set(output_list "${CMAKE_MATCH_1}")
            set(source_inputs "${CMAKE_MATCH_2}")
            if(source_inputs MATCHES "${source_pattern}")
                foreach(output IN LISTS output_list)
                    if(output MATCHES "\\.obj$" OR output MATCHES "\\.o$")
                        _inputnext_object_matches_target("${output}" "${target_identity}" is_target_object)
                        if(is_target_object)
                            math(EXPR target_source_count "${target_source_count} + 1")
                            _inputnext_configuration_matches(
                                "${output}" "" "${target_identity}" "${is_multi}"
                                "${known_configuration}" "${build_type}" "${requested_configuration}"
                                configuration_matches
                            )
                            if(configuration_matches)
                                list(APPEND selected_objects "${output}")
                            endif()
                        endif()
                    endif()
                endforeach()
            endif()
        endif()
    endforeach()

    if(target_source_count EQUAL 0)
        message(FATAL_ERROR "No exact ${target_identity} object for source '${source_pattern}' was found in ${build_file}.")
    endif()
    if(NOT selected_objects)
        message(FATAL_ERROR "No ${target_identity} compile command matched configuration '${requested_configuration}' in ${build_file}.")
    endif()

    foreach(selected_object IN LISTS selected_objects)
        _inputnext_ninja_command("${command_file}" "${build_directory}" "${selected_object}" selected_command)
        if(selected_command STREQUAL "")
            message(FATAL_ERROR "Could not identify the compile command for exact ${target_identity} object '${selected_object}'.")
        endif()
        _is_msvc_analyze_effective("${selected_command}" analyze_enabled)
        if(NOT analyze_enabled)
            message(FATAL_ERROR "Compile command for exact ${target_identity} object '${selected_object}' does not enable /analyze: ${selected_command}")
        endif()
    endforeach()
endfunction()

function(_inputnext_ninja_configuration_files build_directory configuration out_edge_file out_command_file)
    set(wrapper_file "${build_directory}/build-${configuration}.ninja")
    set(implementation_file "${build_directory}/CMakeFiles/impl-${configuration}.ninja")
    if(EXISTS "${wrapper_file}")
        set(command_file "${wrapper_file}")
    elseif(EXISTS "${implementation_file}")
        set(command_file "${implementation_file}")
    else()
        set(command_file "")
    endif()
    if(EXISTS "${implementation_file}")
        set(edge_file "${implementation_file}")
    else()
        set(edge_file "${command_file}")
    endif()
    set(${out_edge_file} "${edge_file}" PARENT_SCOPE)
    set(${out_command_file} "${command_file}" PARENT_SCOPE)
endfunction()

function(assert_analyze_compile_command build_directory source_pattern target_identity requested_configuration)
    string(REGEX REPLACE "\\$$" "" clean_pattern "${source_pattern}")
    _inputnext_build_configuration_info("${build_directory}" is_multi_config configurations build_type)

    set(database_path "${build_directory}/compile_commands.json")
    if(EXISTS "${database_path}")
        file(READ "${database_path}" compile_database)
        string(JSON compile_count LENGTH "${compile_database}")
        set(target_source_count 0)
        set(selected_count 0)
        if(compile_count GREATER 0)
            math(EXPR last_compile "${compile_count} - 1")
            foreach(index RANGE 0 ${last_compile})
                string(JSON source_file GET "${compile_database}" ${index} file)
                if(source_file MATCHES "${clean_pattern}")
                    string(JSON compile_command ERROR_VARIABLE command_error GET "${compile_database}" ${index} command)
                    if(NOT command_error STREQUAL "NOTFOUND")
                        message(FATAL_ERROR "Compile database entry ${index} for ${target_identity} has no command string.")
                    endif()
                    string(JSON output_type ERROR_VARIABLE output_error TYPE "${compile_database}" ${index} output)
                    if(output_error STREQUAL "NOTFOUND")
                        if(NOT output_type STREQUAL "STRING")
                            message(FATAL_ERROR "Compile database output for ${target_identity} is not a string.")
                        endif()
                        string(JSON object_path GET "${compile_database}" ${index} output)
                    else()
                        _inputnext_extract_fo_path("${compile_command}" object_path)
                    endif()
                    if(object_path STREQUAL "")
                        continue()
                    endif()
                    _inputnext_object_matches_target("${object_path}" "${target_identity}" is_target_object)
                    if(NOT is_target_object)
                        continue()
                    endif()
                    math(EXPR target_source_count "${target_source_count} + 1")

                    _inputnext_configuration_matches(
                        "${object_path}" "${compile_command}" "${target_identity}" "${is_multi_config}"
                        "" "${build_type}" "${requested_configuration}" configuration_matches
                    )
                    if(configuration_matches)
                        math(EXPR selected_count "${selected_count} + 1")
                        _is_msvc_analyze_effective("${compile_command}" analyze_enabled)
                        if(NOT analyze_enabled)
                            message(FATAL_ERROR "Compile command for exact ${target_identity} object '${object_path}' (${source_file}) does not enable /analyze: ${compile_command}")
                        endif()
                    endif()
                endif()
            endforeach()
        endif()
        if(target_source_count EQUAL 0)
            message(FATAL_ERROR "No compile database object matched source '${clean_pattern}' in exact target ${target_identity} at ${database_path}.")
        endif()
        if(selected_count EQUAL 0)
            message(FATAL_ERROR "No compile database command for ${target_identity} matched configuration '${requested_configuration}'.")
        endif()
        return()
    endif()

    set(ninja_files "")
    set(ninja_command_files "")
    set(ninja_file_configs "")
    if(is_multi_config AND NOT requested_configuration STREQUAL "")
        _inputnext_ninja_configuration_files(
            "${build_directory}" "${requested_configuration}" configured_ninja_file configured_command_file
        )
        if(NOT configured_ninja_file STREQUAL "")
            list(APPEND ninja_files "${configured_ninja_file}")
            list(APPEND ninja_command_files "${configured_command_file}")
            list(APPEND ninja_file_configs "${requested_configuration}")
        endif()
    elseif(is_multi_config AND configurations)
        foreach(configuration IN LISTS configurations)
            _inputnext_ninja_configuration_files(
                "${build_directory}" "${configuration}" configured_ninja_file configured_command_file
            )
            if(NOT configured_ninja_file STREQUAL "")
                list(APPEND ninja_files "${configured_ninja_file}")
                list(APPEND ninja_command_files "${configured_command_file}")
                list(APPEND ninja_file_configs "${configuration}")
            endif()
        endforeach()
    endif()
    if(NOT ninja_files AND EXISTS "${build_directory}/build.ninja")
        list(APPEND ninja_files "${build_directory}/build.ninja")
        list(APPEND ninja_command_files "${build_directory}/build.ninja")
        list(APPEND ninja_file_configs "__UNSPECIFIED__")
    endif()

    list(LENGTH ninja_files ninja_file_count)
    if(ninja_file_count GREATER 0)
        math(EXPR last_ninja_file "${ninja_file_count} - 1")
        foreach(index RANGE 0 ${last_ninja_file})
            list(GET ninja_files ${index} ninja_file)
            list(GET ninja_command_files ${index} ninja_command_file)
            list(GET ninja_file_configs ${index} known_configuration)
            if(known_configuration STREQUAL "__UNSPECIFIED__")
                set(known_configuration "")
            endif()
            _inputnext_check_ninja_file(
                "${ninja_file}" "${ninja_command_file}" "${build_directory}" "${clean_pattern}" "${target_identity}"
                "${requested_configuration}" "${is_multi_config}" "${known_configuration}" "${build_type}"
            )
        endforeach()
        return()
    endif()

    file(GLOB vcxproj_files "${build_directory}/*.vcxproj" "${build_directory}/*/*.vcxproj")
    if(vcxproj_files)
        message(FATAL_ERROR "MSVC /analyze verification via Visual Studio project files is unsupported due to property-sheet ambiguity. Use Ninja or compile_commands.json.")
    endif()
    message(FATAL_ERROR "Cannot verify MSVC /analyze for ${target_identity}: no compile_commands.json, build.ninja, or .vcxproj found in ${build_directory}.")
endfunction()

function(resolve_strict_consumer_executable consumer_build consumer_executable requested_config out_exe_path)
    set(${out_exe_path} "" PARENT_SCOPE)
    if(DEFINED requested_config AND NOT requested_config STREQUAL "")
        set(multi_config_candidate "${consumer_build}/${requested_config}/${consumer_executable}.exe")
        set(single_config_candidate "${consumer_build}/${consumer_executable}.exe")

        if(EXISTS "${multi_config_candidate}")
            set(${out_exe_path} "${multi_config_candidate}" PARENT_SCOPE)
            return()
        elseif(EXISTS "${single_config_candidate}")
            if(EXISTS "${consumer_build}/CMakeCache.txt")
                file(STRINGS "${consumer_build}/CMakeCache.txt" build_type_entry REGEX "^CMAKE_BUILD_TYPE:STRING=")
                if(build_type_entry STREQUAL "CMAKE_BUILD_TYPE:STRING=${requested_config}")
                    set(${out_exe_path} "${single_config_candidate}" PARENT_SCOPE)
                    return()
                else()
                    message(FATAL_ERROR
                        "Requested configuration '${requested_config}', but consumer directory was configured as '${build_type_entry}'. Refusing to execute mismatched binary.")
                endif()
            else()
                set(${out_exe_path} "${single_config_candidate}" PARENT_SCOPE)
                return()
            endif()
        else()
            message(FATAL_ERROR
                "The standalone consumer did not produce ${consumer_executable}.exe for requested configuration '${requested_config}' in ${consumer_build}. Refusing fallback to other configurations.")
        endif()
    else()
        if(EXISTS "${consumer_build}/${consumer_executable}.exe")
            set(${out_exe_path} "${consumer_build}/${consumer_executable}.exe" PARENT_SCOPE)
            return()
        endif()
        foreach(config_candidate Release RelWithDebInfo Debug MinSizeRel)
            if(EXISTS "${consumer_build}/${config_candidate}/${consumer_executable}.exe")
                set(${out_exe_path} "${consumer_build}/${config_candidate}/${consumer_executable}.exe" PARENT_SCOPE)
                return()
            endif()
        endforeach()
        message(FATAL_ERROR "The standalone consumer did not produce ${consumer_executable}.exe in ${consumer_build}.")
    endif()
endfunction()
