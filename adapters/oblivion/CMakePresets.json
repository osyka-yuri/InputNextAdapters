{
  "version": 12,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 4
  },
  "configurePresets": [
    {
      "name": "windows-x86",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/oblivion-${presetName}",
      "environment": {
        "VSLANG": "1033"
      },
      "warnings": {
        "author": true
      },
      "errors": {
        "author": true
      },
      "cacheVariables": {
        "INPUTNEXTADAPTERS_EXPECTED_BITS": "32",
        "INPUTNEXTADAPTERS_ENABLE_CLANG_TIDY": "OFF",
        "INPUTNEXT_OBLIVION_ENABLE_CLANG_TIDY": "OFF",
        "INPUTNEXT_OBLIVION_BUILD_TESTS": "ON",
        "INPUTNEXT_OBLIVION_ENABLE_ASAN": "OFF",
        "INPUTNEXT_OBLIVION_ENABLE_MSVC_ANALYZE": "OFF"
      }
    },
    {
      "name": "msvc-x86",
      "inherits": "windows-x86",
      "displayName": "Oblivion — MSVC x86",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc-x86-quality",
      "inherits": "msvc-x86",
      "displayName": "Oblivion — MSVC x86 with clang-tidy",
      "cacheVariables": {
        "INPUTNEXT_OBLIVION_ENABLE_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-x86",
      "configurePreset": "msvc-x86"
    },
    {
      "name": "msvc-x86-quality",
      "configurePreset": "msvc-x86-quality"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-x86",
      "configurePreset": "msvc-x86",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 180,
        "noTestsAction": "error"
      }
    },
    {
      "name": "msvc-x86-quality",
      "inherits": "msvc-x86",
      "configurePreset": "msvc-x86-quality"
    }
  ]
}
