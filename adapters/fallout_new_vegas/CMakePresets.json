{
  "version": 12,
  "cmakeMinimumRequired": { "major": 4, "minor": 4, "patch": 4 },
  "configurePresets": [
    {
      "name": "msvc-x86",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/fallout-new-vegas-${presetName}",
      "environment": { "VSLANG": "1033" },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "INPUTNEXTADAPTERS_EXPECTED_BITS": "32",
        "INPUTNEXT_FALLOUT_NEW_VEGAS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "msvc-x86-quality",
      "inherits": "msvc-x86",
      "cacheVariables": { "INPUTNEXTADAPTERS_ENABLE_CLANG_TIDY": "ON" }
    },
    {
      "name": "msvc-x86-native",
      "inherits": "msvc-x86",
      "cacheVariables": {
        "INPUTNEXTADAPTERS_PRODUCTION": "ON",
        "INPUTNEXT_FALLOUT_NEW_VEGAS_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-x86", "configurePreset": "msvc-x86" },
    { "name": "msvc-x86-quality", "configurePreset": "msvc-x86-quality" },
    { "name": "msvc-x86-native", "configurePreset": "msvc-x86-native" }
  ],
  "testPresets": [
    {
      "name": "msvc-x86",
      "configurePreset": "msvc-x86",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 180, "noTestsAction": "error" }
    },
    { "name": "msvc-x86-quality", "configurePreset": "msvc-x86-quality", "inherits": "msvc-x86" }
  ]
}
